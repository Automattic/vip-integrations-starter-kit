{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automattic.github.io/vip-integration/vip-manifest.schema.json",
  "title": "WordPress VIP Integration Handoff Manifest",
  "description": "The single file a partner fills in so VIP can register and load their integration without reading the plugin source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "manifest_kind",
    "integration",
    "documentation",
    "runtime",
    "runtime_config",
    "release"
  ],
  "properties": {
    "manifest_version": {
      "const": 1,
      "description": "Manifest format version. Only \"1\" exists today."
    },
    "manifest_kind": {
      "const": "vip-integration-handoff",
      "description": "Fixed discriminator identifying this file as a handoff manifest."
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "slug", "display_name", "summary", "partner" ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 63,
          "description": "Stable kebab-case identifier, unique across the Integration Center."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Human-readable name shown in the Integration Center."
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "One-line description shown on the catalog card."
        },
        "partner": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "name", "support_contact" ],
          "properties": {
            "name": { "type": "string", "minLength": 1, "description": "Partner / vendor name." },
            "support_contact": {
              "type": "string",
              "minLength": 1,
              "description": "Email address or support URL VIP can reach the partner at."
            }
          }
        }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "public_url" ],
      "description": "Where VIP and customers find documentation for the integration.",
      "properties": {
        "public_url": {
          "type": "string",
          "pattern": "^https?://.+",
          "description": "Customer- or administrator-facing documentation URL."
        },
        "support_url": {
          "type": "string",
          "pattern": "^https?://.+",
          "description": "Optional troubleshooting / partner-support documentation URL."
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "wordpress_plugin" ],
      "properties": {
        "wordpress_plugin": {
          "type": "object",
          "additionalProperties": false,
          "required": [ "folder", "entry_file", "php_namespace", "scope" ],
          "properties": {
            "folder": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "description": "Plugin folder name VIP installs the integration into."
            },
            "entry_file": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+\\.php$",
              "description": "Root plugin file (with the \"Plugin Name:\" header) VIP loads."
            },
            "php_namespace": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\\\[A-Za-z_][A-Za-z0-9_]*)*$",
              "description": "Root PHP namespace the plugin autoloads under."
            },
            "scope": {
              "enum": [ "site", "network" ],
              "description": "Whether the plugin loads per-site or network-wide."
            }
          }
        }
      }
    },
    "runtime_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "constant_name", "fields" ],
      "properties": {
        "constant_name": {
          "type": "string",
          "pattern": "^VIP_[A-Z0-9_]+_CONFIG$",
          "description": "The VIP-defined config constant the plugin reads, e.g. VIP_ACME_CONFIG."
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "description": "The config fields the Integration Center renders and stores.",
          "items": { "$ref": "#/$defs/configField" }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "prefix", "default_properties", "events" ],
      "description": "VIP Tracks events the integration records. Omit this section entirely if it records none.",
      "properties": {
        "prefix": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*_$",
          "description": "Event name prefix: a single word plus a trailing underscore, e.g. acmewidget_. Tracks prefixes are one token identifying the product, so squash a multi-word name rather than joining its words with underscores (acmewidget_, not acme_widget_)."
        },
        "default_properties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": "Property names attached to every event."
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/telemetryEvent" },
          "description": "The individual Tracks events. Declares names only, never captured values."
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "plugin_version", "version_strategy", "migration_required", "changelog" ],
      "description": "Metadata about the submitted plugin version.",
      "properties": {
        "plugin_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-+][A-Za-z0-9.-]+)?$",
          "description": "Semantic version matching the plugin header."
        },
        "version_strategy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Release strategy identifier, e.g. latest or semantic_versioning."
        },
        "migration_required": {
          "type": "boolean",
          "description": "Whether this release requires migration work."
        },
        "changelog": {
          "type": "string",
          "minLength": 1,
          "description": "Short description of what this release contains."
        }
      }
    }
  },
  "$defs": {
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "key", "label", "type" ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
          "description": "snake_case key this value is stored under in the config array."
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Field label shown in the Integration Center form."
        },
        "type": {
          "enum": [
            "string",
            "text",
            "url",
            "email",
            "number",
            "boolean",
            "secret",
            "enum",
            "list"
          ],
          "description": "Input type. Use \"secret\" for values VIP must encrypt at rest."
        },
        "required": {
          "type": "boolean",
          "description": "Whether the field must be filled before the integration can activate."
        },
        "help": { "type": "string", "description": "Optional helper text shown under the field." },
        "default": {
          "type": [ "string", "number", "boolean", "array" ],
          "items": { "type": "string" },
          "description": "Optional default value pre-filled in the form. Must follow the field's own rules; a list for \"list\" fields."
        },
        "example": {
          "type": [ "string", "number", "array" ],
          "items": { "type": "string" },
          "description": "Optional example value, shown as the input placeholder. Must follow the field's own rules; a list for \"list\" fields."
        },
        "nullable": {
          "type": "boolean",
          "description": "Whether saving null clears the value, so the plugin falls back to its own default. Defaults to false."
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Allowed values. Required when \"type\" is \"enum\"."
        },
        "integer": {
          "type": "boolean",
          "description": "Number fields only: whether the value must be a whole number."
        },
        "min": {
          "type": "number",
          "description": "Number fields only: the smallest allowed value."
        },
        "max": {
          "type": "number",
          "description": "Number fields only: the largest allowed value."
        },
        "unit": {
          "enum": [ "seconds", "minutes", "hours", "days" ],
          "description": "Number fields only: the unit the value is in, e.g. seconds."
        },
        "min_length": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of characters."
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of characters."
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Regular expression (JavaScript syntax) the whole value must match. Needs an \"example\", so the form can show the expected format."
        },
        "format": {
          "enum": [ "ip_or_cidr", "url", "email" ],
          "description": "A common format the value must have, e.g. ip_or_cidr."
        },
        "items": {
          "$ref": "#/$defs/listItem",
          "description": "List fields only: what each entry must be. Required when \"type\" is \"list\"."
        },
        "max_items": {
          "type": "integer",
          "minimum": 1,
          "description": "List fields only: the most entries the list may have."
        },
        "autogen": {
          "type": "boolean",
          "description": "Whether the field is autogenerated and not editable by the customer."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Optional note on the field's purpose or usage. For internal use."
        }
      },
      "allOf": [
        {
          "$comment": "An enum field needs \"values\".",
          "if": { "required": [ "type" ], "properties": { "type": { "const": "enum" } } },
          "then": { "required": [ "values" ] }
        },
        {
          "$comment": "A list field needs \"items\".",
          "if": { "required": [ "type" ], "properties": { "type": { "const": "list" } } },
          "then": { "required": [ "items" ] }
        },
        {
          "$comment": "A field with \"pattern\" needs an \"example\", so the form can show the expected format.",
          "if": {
            "anyOf": [
              { "required": [ "pattern" ] },
              {
                "required": [ "items" ],
                "properties": { "items": { "type": "object", "required": [ "pattern" ] } }
              }
            ]
          },
          "then": { "required": [ "example" ] }
        },
        {
          "$comment": "A required field can't be nullable, since it can't be cleared.",
          "if": { "required": [ "required" ], "properties": { "required": { "const": true } } },
          "then": { "properties": { "nullable": { "const": false } } }
        },
        {
          "$comment": "\"integer\" only applies to type \"number\".",
          "if": { "required": [ "integer" ] },
          "then": { "properties": { "type": { "enum": [ "number" ] } } }
        },
        {
          "$comment": "\"min\" only applies to type \"number\".",
          "if": { "required": [ "min" ] },
          "then": { "properties": { "type": { "enum": [ "number" ] } } }
        },
        {
          "$comment": "\"max\" only applies to type \"number\".",
          "if": { "required": [ "max" ] },
          "then": { "properties": { "type": { "enum": [ "number" ] } } }
        },
        {
          "$comment": "\"unit\" only applies to type \"number\".",
          "if": { "required": [ "unit" ] },
          "then": { "properties": { "type": { "enum": [ "number" ] } } }
        },
        {
          "$comment": "\"min_length\" only applies to type \"string\", \"text\", \"url\", \"email\", \"secret\".",
          "if": { "required": [ "min_length" ] },
          "then": {
            "properties": { "type": { "enum": [ "string", "text", "url", "email", "secret" ] } }
          }
        },
        {
          "$comment": "\"max_length\" only applies to type \"string\", \"text\", \"url\", \"email\", \"secret\".",
          "if": { "required": [ "max_length" ] },
          "then": {
            "properties": { "type": { "enum": [ "string", "text", "url", "email", "secret" ] } }
          }
        },
        {
          "$comment": "\"pattern\" only applies to type \"string\", \"text\", \"url\", \"email\", \"secret\".",
          "if": { "required": [ "pattern" ] },
          "then": {
            "properties": { "type": { "enum": [ "string", "text", "url", "email", "secret" ] } }
          }
        },
        {
          "$comment": "\"format\" only applies to type \"string\".",
          "if": { "required": [ "format" ] },
          "then": { "properties": { "type": { "enum": [ "string" ] } } }
        },
        {
          "$comment": "\"items\" only applies to type \"list\".",
          "if": { "required": [ "items" ] },
          "then": { "properties": { "type": { "enum": [ "list" ] } } }
        },
        {
          "$comment": "\"max_items\" only applies to type \"list\".",
          "if": { "required": [ "max_items" ] },
          "then": { "properties": { "type": { "enum": [ "list" ] } } }
        },
        {
          "$comment": "\"example\" only applies to type \"string\", \"text\", \"url\", \"email\", \"number\", \"secret\", \"list\".",
          "if": { "required": [ "example" ] },
          "then": {
            "properties": {
              "type": { "enum": [ "string", "text", "url", "email", "number", "secret", "list" ] }
            }
          }
        }
      ]
    },
    "listItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "type" ],
      "description": "What each entry of a list field must be.",
      "properties": {
        "type": { "enum": [ "string" ], "description": "Entry type. Only \"string\" for now." },
        "min_length": {
          "type": "integer",
          "minimum": 0,
          "description": "Minimum number of characters."
        },
        "max_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of characters."
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Regular expression (JavaScript syntax) the whole value must match. Needs an \"example\", so the form can show the expected format."
        },
        "format": {
          "enum": [ "ip_or_cidr", "url", "email" ],
          "description": "A common format the value must have, e.g. ip_or_cidr."
        }
      }
    },
    "telemetryEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "type", "trigger", "properties" ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Full event name, including the telemetry prefix."
        },
        "type": {
          "enum": [ "tracks" ],
          "description": "Telemetry channel. VIP integrations use Tracks only."
        },
        "trigger": {
          "type": "string",
          "minLength": 1,
          "description": "What causes the event to fire."
        },
        "properties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": "Property names recorded with the event (names only, no values)."
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "description": "Optional note on why the event exists."
        }
      }
    }
  }
}
